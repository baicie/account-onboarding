# Build artifacts
/bin/
/dist/
/onboardd

# Local runtime state; never bake the database, WAL files or secrets into an image
/data/
/secrets/
/.sandbox/
/deploy/data/
/deploy/secrets/
/deploy/.env
/deploy/.env.*
*.sqlite
*.sqlite-wal
*.sqlite-shm

# VCS and editor noise
.git
.github
.editorconfig
*.md

# Local env files
.env
.env.*

# Frontend dependencies are installed inside the build stage, never copied from the host
/web/node_modules
/web/dist
