# syntax=docker/dockerfile:1
# ARM64 acceptance image (test-only).
#
# Mirrors the production runtime contract but cross-compiles linux/arm64
# binaries from the native build platform, so an emulated builder never has to
# run the Go toolchain under QEMU. It additionally ships the operator tools
# (backup/restore/verify/keyring) so backup, restore and schema checks can run
# *inside* the arm64 container instead of on the host.
ARG GOLANG_IMAGE=golang:1.26.10-bookworm@sha256:632dff7351799a5a9954a48dc06670ade72ee44e8c351cdc0e5a57af2fea21af
ARG RUNTIME_IMAGE=debian:bookworm-slim@sha256:7ff6ba31527b9e336162fa061746c366c4b2032f4d2cff2078bea43f78efe3f8

FROM --platform=$BUILDPLATFORM ${GOLANG_IMAGE} AS build
ARG VERSION=0.1.0
ARG COMMIT=unknown
# The cross toolchain is what a linux/amd64 build host needs; a native arm64
# build host only needs its own gcc, so the cross package is optional there.
ARG CROSS_CC=aarch64-linux-gnu-gcc
RUN apt-get update \
    && apt-get install -y --no-install-recommends gcc libc6-dev ca-certificates \
    && (apt-get install -y --no-install-recommends gcc-aarch64-linux-gnu libc6-dev-arm64-cross || true) \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
ENV CGO_ENABLED=1 GOOS=linux GOARCH=arm64
ENV CC=$CROSS_CC
RUN go build -trimpath \
      -ldflags="-s -w -X github.com/baicie/account-onboarding/internal/api.Version=$VERSION -X github.com/baicie/account-onboarding/internal/api.Commit=$COMMIT" \
      -o /out/onboardd ./cmd/onboardd \
 && go build -trimpath -ldflags="-s -w" -o /out/backup ./internal/ops/cmd/backup \
 && go build -trimpath -ldflags="-s -w" -o /out/restore ./internal/ops/cmd/restore \
 && go build -trimpath -ldflags="-s -w" -o /out/verify ./internal/ops/cmd/verify \
 && go build -trimpath -ldflags="-s -w" -o /out/keyring ./internal/ops/cmd/keyring

FROM ${RUNTIME_IMAGE} AS runtime
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates tzdata bash util-linux curl \
    && rm -rf /var/lib/apt/lists/* \
    && groupadd -g 10001 onboard \
    && useradd -u 10001 -g 10001 -M -s /usr/sbin/nologin onboard \
    && mkdir -p /app/data /app/backups \
    && chown 10001:10001 /app/data /app/backups
COPY --from=build /out/ /usr/local/bin/
COPY --from=build /src/scripts/materialize_secrets.sh /app/scripts/materialize_secrets.sh
RUN chmod 0755 /app/scripts/materialize_secrets.sh
WORKDIR /app
USER 10001:10001
ENV ONBOARD_LISTEN=0.0.0.0:8788 \
    ONBOARD_DB_PATH=/app/data/state.sqlite \
    ONBOARD_LOG_LEVEL=info
ENTRYPOINT ["/usr/local/bin/onboardd"]
