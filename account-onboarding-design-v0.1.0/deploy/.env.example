# EXAMPLE ONLY. Never put plaintext real secret values into this file.
# Leave real providers disabled unless explicit signed-off integration test.
ONBOARD_LISTEN=0.0.0.0:8788
ONBOARD_DB_PATH=/app/data/state.sqlite
ONBOARD_MODE=sandbox
ONBOARD_MAX_CONCURRENCY=2
ONBOARD_CLOUDFLARE_BASE_URL=https://api.moonbyte.top
ONBOARD_CLOUDFLARE_ENABLED=false
ONBOARD_GITHUB_ENABLED=false
ONBOARD_WORKBUDDY_ENABLED=false
ONBOARD_MASTER_KEY_FILE=/run/secrets/onboarding_master_key
