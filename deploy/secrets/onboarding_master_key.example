# deploy/secrets/onboarding_master_key.example
#
# EXAMPLE ONLY — THIS IS NOT A SECRET AND MUST NEVER BE USED IN A DEPLOYMENT.
# It is a valid 32-byte ASCII placeholder so the format is obvious; replace it
# with a freshly generated key before first boot:
#
#   scripts/generate_master_key.sh --out deploy/secrets/onboarding_master_key
#   # or, manually:
#   go run ./internal/ops/cmd/keyring init -out deploy/secrets/onboarding_master_key
#
# Accepted formats (config.DecodeMasterKey / security.LoadKeyRing):
#   * 32 raw bytes
#   * 64 hex characters
#   * base64 of 32 bytes
#   * JSON keyring envelope: {"current":1,"keys":{"1":"<base64 of 32 bytes>"}}
#
# A JSON keyring is required for key rotation (version N+1 keeps version N).
# File permissions: 0600, owned by the operator. Never commit the real file;
# deploy/.gitignore excludes deploy/secrets/*.
REPLACE_ME_WITH_32_RANDOM_BYTES!!!
