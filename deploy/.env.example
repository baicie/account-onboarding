# EXAMPLE ONLY. Never put plaintext real secret values into this file.
# Leave real providers disabled unless an explicit signed-off integration test
# is being performed.
#
# This file documents the environment contract of deploy/compose.yaml. Compose
# itself only needs the secret files referenced below; everything here is the
# container-internal view.
ONBOARD_LISTEN=0.0.0.0:8788
# Required because the container listens on 0.0.0.0; the host publishing in
# compose.yaml is loopback only (127.0.0.1:8788).
ONBOARD_ALLOW_PUBLIC_LISTEN=1
ONBOARD_DB_PATH=/app/data/state.sqlite
ONBOARD_MODE=sandbox
ONBOARD_MAX_CONCURRENCY=2
ONBOARD_LOG_LEVEL=info

# Secret files (Docker Secrets, mounted read-only at /run/secrets/*).
ONBOARD_MASTER_KEY_FILE=/run/secrets/onboarding_master_key
ONBOARD_ADMIN_TOKEN_FILE=/run/secrets/onboard_admin_token
# Never set ONBOARD_DEV_EPHEMERAL_KEY in a deployment: stored secrets would not
# survive a restart.

# Minimal RBAC (two roles, single operator service): the optional read-only
# viewer token grants GET access only; every mutation still requires the admin
# token. The two tokens must differ (config validation enforces it). There are
# no per-user accounts, 2FA or role management in v0.1.0.
# Prefer the file form; if you mount it, add a compose secret for it.
# ONBOARD_READONLY_TOKEN_FILE=/run/secrets/onboard_readonly_token
# ONBOARD_READONLY_TOKEN=replace-with-a-random-viewer-token

# Per-client-IP rate limiting (60s fixed window; 0 disables the bucket).
# General bucket covers the whole control plane (including /healthz), the login
# bucket is stricter and only applies to POST /ui/login.
ONBOARD_RATE_LIMIT_PER_MINUTE=300
ONBOARD_LOGIN_RATE_LIMIT_PER_MINUTE=10

# Only enable behind a trusted TLS-terminating reverse proxy. It makes
# X-Forwarded-For the rate-limit key and X-Forwarded-Proto=https mark the session
# cookie Secure. Do NOT enable while clients can reach the service directly:
# then any client could spoof those headers.
# ONBOARD_TRUST_PROXY_HEADERS=1

# Offline test-only provider set; must stay false in deployments.
ONBOARD_FAKE_PROVIDERS=false

# Live providers stay disabled until an explicit, reviewed integration window.
ONBOARD_CLOUDFLARE_ENABLED=false
ONBOARD_CLOUDFLARE_BASE_URL=https://api.moonbyte.top
ONBOARD_GITHUB_ENABLED=false
ONBOARD_WORKBUDDY_ENABLED=false
ONBOARD_KEYCLOAK_ENABLED=false
ONBOARD_MAILPIT_ENABLED=false
ONBOARD_OIDC_ENABLED=false

# Provider credential secret files (only when the matching adapter is enabled):
# cloudflare_admin_password_file=/run/secrets/cf_admin_password
# github_pat_file=/run/secrets/github_pat
# workbuddy_token_file=/run/secrets/workbuddy_gateway_token

# ---------------------------------------------------------------------------
# Operator backup tooling (scripts/backup.sh) — NOT read by the service.
# Encryption at rest is opt-in; the same keyring is used for verify and restore:
#   ONBOARD_BACKUP_ENCRYPT=1
#   ONBOARD_KEYRING=/run/secrets/onboarding_master_key
#   scripts/backup.sh --db /app/data/state.sqlite --out-dir ./backups \
#       --encrypt --keyring /run/secrets/onboarding_master_key
# ---------------------------------------------------------------------------
