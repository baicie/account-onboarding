# Copy to a gitignored local env file. Staging values only; never production.
R8_IMAGE=account-onboarding:staging-local
R8_INGRESS_IMAGE=account-onboarding-ingress:staging-local
R8_DATA=.sandbox/r8/staging/data
R8_CERTS=.sandbox/r8/staging/certs
R8_MASTER_KEY=.sandbox/r8/staging/secrets/master.key
R8_ADMIN_TOKEN=.sandbox/r8/staging/secrets/admin.token
R8_HTTPS_PORT=28443
R8_HTTP_PORT=28080
